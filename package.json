{
  "name": "automation-testing",
  "version": "1.0.0",
  "description": "SauceDemo UI & DemoQA API Automation Testing Framework with Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api/",
    "test:ui": "playwright test tests/module/ tests/endtoend/",
    "test:module": "playwright test tests/module/",
    "test:e2e": "playwright test tests/endtoend/",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:allure": "playwright test && allure generate allure-results --clean -o allure-report",
    "docker:build": "docker compose build",
    "docker:test": "docker compose up --build playwright-tests",
    "docker:test:api": "docker compose run --rm playwright-tests npm run test:api",
    "docker:test:ui": "docker compose run --rm playwright-tests npm run test:ui",
    "docker:test:e2e": "docker compose run --rm playwright-tests npm run test:e2e",
    "docker:report": "docker compose up playwright-report",
    "docker:allure": "docker compose up allure-report",
    "docker:deploy": "docker compose up -d allure-report playwright-report",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "api-testing",
    "pom",
    "saucedemo",
    "demoqa",
    "allure-report"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0"
  }
}
